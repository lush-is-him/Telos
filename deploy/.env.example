# cp .env.example .env && edit. Never commit .env.
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 32   (paste the same value into the app's Settings)
TELOS_TOKEN=change-me
# Your IANA timezone (e.g. Europe/London), used for "which hour do I work" analysis
TELOS_TZ=UTC
# From: tailscale ip -4
TAILSCALE_IP=100.x.y.z
# Where weekly dumps go, and an optional second copy (external drive / other disk)
BACKUP_DIR=/var/backups/telos
BACKUP_MIRROR=
KEEP_WEEKS=8
